# Copy to .env.local and fill in. See SPEC.md for details.

# Local: file:./data/upsolve.db — Production: libsql://<db>-<org>.turso.io
DATABASE_URL=file:./data/upsolve.db
DATABASE_AUTH_TOKEN=

# Timezone used to show solve dates (IANA name). Defaults to Asia/Kolkata.
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata

# Solution analysis via OpenRouter (https://openrouter.ai/keys). Model is optional.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Generate both with: bun hash-passcode "<your passcode>"
UPSOLVE_PASSCODE_HASH=
AUTH_SECRET=
